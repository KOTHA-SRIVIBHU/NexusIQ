{
  "manifest_version": 3,
  "name": "NexusIQ",
  "version": "1.0.0",
  "description": "AI-powered knowledge base companion — share content, search your docs, and capture knowledge from any webpage.",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/search.html",
    "default_title": "NexusIQ Search"
  },
  "options_page": "options/options.html",
  "commands": {
    "search-nexusiq": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open NexusIQ quick search"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
